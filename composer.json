{
  "name": "asog/asog",
  "description": "",
  "type": "project",
  "require": {
    "php": "^8.4",
    "symfony/framework-bundle": "^6.4",
    "symfony/console": "^6.4",
    "symfony/flex": "^2.10",
    "ext-gmp": "*",
    "symfony/runtime": "^8.0",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "friendsofphp/php-cs-fixer": "^3.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    }
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
    "cs-check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --stop-on-violation --diff"
  }
}
